DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.lvh.me
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://app.lvh.me:8000,http://*.lvh.me:8000
DJANGO_ADMIN_URL=admin/
DJANGO_DEFAULT_FROM_EMAIL=Booster <noreply@booster.local>
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SESSION_COOKIE_DOMAIN=.lvh.me
DJANGO_CSRF_COOKIE_DOMAIN=.lvh.me
DJANGO_SHOW_PUBLIC_IF_NO_TENANT_FOUND=1
DJANGO_TENANT_HEADER=HTTP_X_TENANT_SLUG
DJANGO_PRIMARY_DOMAIN=lvh.me
DJANGO_PUBLIC_HOST=app.lvh.me

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/booster
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PRICE_ID=price_free
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_SUCCESS_URL=http://app.lvh.me:8000/billing/success/
STRIPE_CANCEL_URL=http://app.lvh.me:8000/billing/

EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
